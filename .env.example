# Uygulama Ayarları
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5000

# Loglama Ayarları
LOG_LEVEL=INFO
LOG_FILE=log.log

# KVKK / Gizlilik
KVKK_SCRUBBER_ENABLED=true

# OpenSearch Log Gönderimi (OPENSEARCH_HOST boş bırakılırsa devre dışı kalır)
OPENSEARCH_HOST=
OPENSEARCH_PORT=9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=segment-parser
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=true
